# shellcheck shell=bash
# shellcheck disable=SC1090,SC1091

##### zsh #####
# Miscellaneous
setopt appendhistory autocd extendedglob extendedhistory histfindnodups histignorealldups histignorespace sharehistory
WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'

# History
HISTSIZE=10000                  # number of commands to load into memory
SAVEHIST=100000                 # number of commands to save in history file (>= HISTSIZE)
HISTFILE="${HOME}/.zsh_history" # location of history file

# Completions
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select

if command -v brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

_completions_dir="${HOME}/.local/share/zsh-completions"
FPATH="${_completions_dir}:${FPATH}"

##### zgenom #####
[[ -d "${HOME}/.zgenom" ]] || git clone https://github.com/jandamm/zgenom.git "${HOME}/.zgenom"
. "${HOME}/.zgenom/zgenom.zsh"

zgenom autoupdate
if ! zgenom saved; then
  rm -f "${HOME}/.zcompdump*"

  mkdir -p "${_completions_dir}"
  function _load_completions() {
    local _function="${1}"
    shift
    local _command="${1}"
    command -v "${_command}" >/dev/null && "${@}" >"${_completions_dir}/${_function}"
  }
  _load_completions _atuin atuin gen-completions --shell=zsh
  _load_completions _cargo rustup completions zsh cargo
  _load_completions _chezmoi chezmoi completion zsh
  _load_completions _gh gh completion --shell=zsh
  _load_completions _k3d k3d completion zsh
  _load_completions _k9s k9s completion zsh
  _load_completions _kafkactl kafkactl completion zsh
  _load_completions _kubectl kubectl completion zsh
  _load_completions _orb orb completion zsh
  _load_completions _pipx register-python-argcomplete --shell=zsh pipx
  _load_completions _rbw rbw gen-completions zsh
  _load_completions _rustup rustup completions zsh rustup
  _load_completions _task task --completion=zsh
  _load_completions _watchexec watchexec --completions=zsh
  _load_completions _wezterm wezterm shell-completion --shell=zsh
  _load_completions _yq yq completion zsh

  zgenom load djui/alias-tips
  zgenom load hlissner/zsh-autopair
  zgenom load MichaelAquilina/zsh-auto-notify
  zgenom load romkatv/powerlevel10k powerlevel10k
  zgenom load zdharma-continuum/fast-syntax-highlighting
  zgenom load zsh-users/zsh-autosuggestions
  zgenom load zsh-users/zsh-completions

  zgenom save
  zgenom compile "${HOME}/.zshrc"
  zgenom clean
fi

##### Bash completions #####
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C terraform terraform

##### Powerlevel10k #####
# powerlevel10k opens a wizard if it doesn't find a configuration file.
# However, the wizard also shows up due to errors in your .zshrc,
# or due to hitting Ctrl-C before the prompt finishes loading.
export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD='true'
export POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD='1'

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
[[ -r "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${USER}.zsh" ]] &&
  . "${XDG_CACHE_HOME:-${HOME}/.cache}/p10k-instant-prompt-${USER}.zsh"

