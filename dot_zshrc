alias sudo='sudo '

# Convenient aliases for frequently used commands.
alias c='cursor'
alias k='kubectl'
alias p='python'
alias t='task'
alias v='nvim'

alias bs="go run -C $HOME/ws/bufstream ./cmd/bufstream"
