##### Hooks #####
# When cd-ing into a directory, print its contents.
function _ls_hook() {
  eza --group-directories-first
}
chpwd_functions=(${chpwd_functions[@]} _ls_hook)

##### atuin #####
eval "$(atuin init zsh --disable-up-arrow)"

##### bat #####
export BAT_THEME='TwoDark'

##### direnv #####
eval "$(direnv hook zsh)"

##### vivid #####
LS_COLORS="$(vivid generate one-dark)"
export LS_COLORS

##### zoxide #####
[[ -d "${HOME}/ws/zoxide/target/debug" ]] && export PATH="${HOME}/ws/zoxide/target/debug:${PATH}"
eval "$(zoxide init zsh)"

##### zsh-auto-notify #####
export AUTO_NOTIFY_TITLE="Completed: %command"
export AUTO_NOTIFY_THRESHOLD=5

##### Keybindings #####
set -o vi

KEYTIMEOUT=1

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey '^[[A' up-line-or-beginning-search   # UpArrow
bindkey '^[[B' down-line-or-beginning-search # DownArrow
bindkey '^[[H' beginning-of-line             # Home
bindkey '^[[F' end-of-line                   # End
bindkey '^[^?' backward-kill-word            # Alt+Backspace
bindkey '^[[3;3~' kill-word                  # Alt+Delete

bindkey -M viins '^[b' backward-word     # Opt+LeftArrow (readline-style)
bindkey -M viins '^[f' forward-word      # Opt+RightArrow (readline-style)
bindkey -M viins '^[[1;3D' backward-word # Opt+LeftArrow (xterm-style)
bindkey -M viins '^[[1;3C' forward-word  # Opt+RightArrow (xterm-style)

##### Powerlevel10k #####
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f "${HOME}/.p10k.zsh" ]] && . "${HOME}/.p10k.zsh"
